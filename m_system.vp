fn system_getClipboard(T : tea_State*) : void
{
    let window : GLFWwindow* = spxeGetWindow();
    let text : const uint8* = glfwGetClipboardString(window);
    tea_push_string(T, text);
}

fn system_setClipboard(T : tea_State*) : void
{
    let window : GLFWwindow* = spxeGetWindow();
    let text : const uint8* = tea_check_string(T, 0);
    glfwSetClipboardString(window, text);
}

let sreg : const tea_Reg[] = {
    {"info", system_info, 1, 0},
    {"getClipboard", system_getClipboard, 0, 0},
    {"setClipboard", system_setClipboard, 1, 0},
    {}
};

pub fn micro_open_system(T : tea_State*) : void
{
    tea_create_submodule(T, "system", sreg);
}