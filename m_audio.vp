fn audio_init(T : tea_State*) : void
{
    let rate : int32 = intcast(int32, tea_opt_integer(T, 0, 44100));
    let bufferSize : int32 = intcast(int32, tea_opt_integer(T, 1, 44100));
    //UNUSED(bufferSize);
    if ainited
    {
        tea_error(T, "audio is already inited");
    }

    /*ma_device_config config;
    config = ma_device_config_init(ma_device_type_playback);
    config.playback.format = ma_format_s16;
    config.playback.channels = 2;
    config.sampleRate = rate;
    config.dataCallback = audio_callback;
    config.pUserData = T;

    if ma_device_init(nil, &config, &device) != MA_SUCCESS
    {
        tea_error(T, "could not init audio");
    }*/

    samplerate = rate;
    ainited = true;
    /*source_setSamplerate(samplerate);

    if ma_device_start(&device) != MA_SUCCESS
    {
        tea_error(T, "could not start audio");
    }*/
}

let areg : tea_Reg[] = {
    {"init", audio_init, 0, 2},
    {}
};

pub fn micro_open_audio(T : tea_State*) : void
{
    tea_create_submodule(T, "audio", areg);
    // Add .master Source field
}