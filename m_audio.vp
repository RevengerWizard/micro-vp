    }*/
}

let areg : tea_Reg[] = {
    {"init", audio_init, 0, 2},
    {}
};

pub fn micro_open_audio(T : tea_State*) : void
{
    tea_create_submodule(T, "audio", areg);

    // Add .master Source field
    let ref : int32;
    source_getMaster(&ref);
    tea_push_integer(T, intcast(tea_Integer, ref));
    tea_get_field(T, TEA_REGISTRY_INDEX);
    tea_set_attr(T, -2, "master");
}