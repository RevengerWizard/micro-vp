fn audio_init(T : tea_State*) : void
{
    let rate : int32 = intcast(int32, tea_opt_integer(T, 0, 44100));
    let bufferSize : int32 = intcast(int32, tea_opt_integer(T, 1, 44100));
    if ainited
    {
        tea_error(T, "audio is already inited");
    }

    /*let allocationCallbacks : ma_allocation_callbacks;
    allocationCallbacks.onMalloc = audio_malloc;
    allocationCallbacks.onRealloc = audio_realloc;
    allocationCallbacks.onFree = audio_free;

    let context : ma_context;
    let contextConfig : ma_context_config = ma_context_config_init();
    contextConfig.allocationCallbacks = allocationCallbacks;

    if ma_context_init(nil, 0, &contextConfig, &context) != ma_result::MA_SUCCESS
    {
        tea_error(T, "could not init audio context");
    }

    let config : ma_device_config = ma_device_config_init(ma_device_type::ma_device_type_playback);
    config.playback.format = ma_format::ma_format_s16;
    config.playback.channels = 2;
    config.sampleRate = intcast(uint32, rate);
    config.dataCallback = ptrcast(ma_device_data_proc, audio_callback);
