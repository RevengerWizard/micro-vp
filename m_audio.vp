fn audio_malloc(sz : usize, pUserData : void*) : void*
{
    //(void)pUserData;
    return mem::alloc(sz);
}

fn audio_realloc(p : void*, sz : usize, pUserData : void*) : void*
{
    //(void)pUserData;
    return mem::realloc(p, sz);
}

fn audio_free(p : void*, pUserData : void*) : void
{
    //(void)pUserData;
    mem::free(p);
}

