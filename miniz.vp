pub def MZ_OK = 0;
pub def MZ_STREAM_END = 1;
pub def MZ_NEED_DICT = 2;
pub def MZ_ERRNO = -1;
pub def MZ_STREAM_ERROR = -2;
pub def MZ_DATA_ERROR = -3;
pub def MZ_MEM_ERROR = -4;
pub def MZ_BUF_ERROR = -5;
pub def MZ_VERSION_ERROR = -6;
pub def MZ_PARAM_ERROR = -10000;

pub def MZ_NO_FLUSH = 0;
pub def MZ_PARTIAL_FLUSH = 1;
pub def MZ_SYNC_FLUSH = 2;
pub def MZ_FULL_FLUSH = 3;
pub def MZ_FINISH = 4;
pub def MZ_BLOCK = 5;

pub def MZ_NO_COMPRESSION = 0;
pub def MZ_BEST_SPEED = 1;
pub def MZ_BEST_COMPRESSION = 9;
pub def MZ_UBER_COMPRESSION = 10;
pub def MZ_DEFAULT_LEVEL = 6;
pub def MZ_DEFAULT_COMPRESSION = -1;

pub def MZ_DEFAULT_STRATEGY = 0;
pub def MZ_FILTERED = 1;
pub def MZ_HUFFMAN_ONLY = 2;
pub def MZ_RLE = 3;
pub def MZ_FIXED = 4;

pub def MZ_DEFLATED = 8;
pub def MZ_DEFAULT_WINDOW_BITS = 15;

pub def MZ_ADLER32_INIT = 1;
pub def MZ_CRC32_INIT = 0;

pub def MZ_FALSE = 0;
pub def MZ_TRUE = 1;

pub def MZ_UINT16_MAX = 0xFFFFu32;
pub def MZ_UINT32_MAX = 0xFFFFFFFFu32;

/* unsigned long = 32 bit on Windows, 64 bit elsewhere... */
pub alias mz_ulong = uint32;
pub alias mz_bool = int32;
pub alias MZ_TIME = int64;

pub alias mz_alloc_func = fn(opaque : void*, items : usize, size : usize) : void*;
pub alias mz_free_func = fn(opaque : void*, address : void*) : void;
pub alias mz_realloc_func = fn(opaque : void*, address : void*, items : usize, size : usize) : void*;

pub alias mz_file_read_func = fn(pOpaque : void*, file_ofs : uint64, pBuf : void*, n : usize) : usize;
pub alias mz_file_write_func = fn(pOpaque : void*, file_ofs : uint64, pBuf : const void*, n : usize) : usize;
pub alias mz_file_needs_keepalive = fn(pOpaque : void*) : mz_bool;

/* ------------------- zlib-style stream */

pub struct mz_internal_state;

pub struct mz_stream
{
    next_in   : const uint8*;
    avail_in  : uint32;
    total_in  : mz_ulong;

    next_out  : uint8*;
    avail_out : uint32;
    total_out : mz_ulong;

    msg       : uint8*;
    state     : mz_internal_state*;

    zalloc    : mz_alloc_func;
    zfree     : mz_free_func;
    opaque    : void*?;

    data_type : int32;
    adler     : mz_ulong;
    reserved  : mz_ulong;
}

pub alias mz_streamp = mz_stream*;

/* ------------------- zlib-style API */

pub fn mz_version() : const uint8*;

pub fn mz_deflateInit(pStream : mz_streamp, level : int32) : int32;
pub fn mz_deflateInit2(pStream : mz_streamp, level : int32, method : int32, window_bits : int32, mem_level : int32, strategy : int32) : int32;
pub fn mz_deflateReset(pStream : mz_streamp) : int32;
pub fn mz_deflate(pStream : mz_streamp, flush : int32) : int32;
pub fn mz_deflateEnd(pStream : mz_streamp) : int32;
pub fn mz_deflateBound(pStream : mz_streamp, source_len : mz_ulong) : mz_ulong;

pub fn mz_compress(pDest : uint8*, pDest_len : mz_ulong*, pSource : const uint8*, source_len : mz_ulong) : int32;
pub fn mz_compress2(pDest : uint8*, pDest_len : mz_ulong*, pSource : const uint8*, source_len : mz_ulong, level : int32) : int32;
pub fn mz_compressBound(source_len : mz_ulong) : mz_ulong;

pub fn mz_inflateInit(pStream : mz_streamp) : int32;
pub fn mz_inflateInit2(pStream : mz_streamp, window_bits : int32) : int32;
pub fn mz_inflateReset(pStream : mz_streamp) : int32;
pub fn mz_inflate(pStream : mz_streamp, flush : int32) : int32;
pub fn mz_inflateEnd(pStream : mz_streamp) : int32;

pub fn mz_uncompress(pDest : uint8*, pDest_len : mz_ulong*, pSource : const uint8*, source_len : mz_ulong) : int32;
pub fn mz_uncompress2(pDest : uint8*, pDest_len : mz_ulong*, pSource : const uint8*, pSource_len : mz_ulong*) : int32;

pub fn mz_adler32(adler : mz_ulong, ptr : const uint8*, buf_len : usize) : mz_ulong;
pub fn mz_crc32(crc : mz_ulong, ptr : const uint8*, buf_len : usize) : mz_ulong;

pub fn mz_free(p : void*) : void;
pub fn mz_error(err : int32) : const uint8*;

pub fn miniz_def_alloc_func(opaque : void*, items : usize, size : usize) : void*;
pub fn miniz_def_free_func(opaque : void*, address : void*) : void;
pub fn miniz_def_realloc_func(opaque : void*, address : void*, items : usize, size : usize) : void*;

/* ------------------- tdefl (low-level compressor) */

pub def TDEFL_HUFFMAN_ONLY        = 0;
pub def TDEFL_DEFAULT_MAX_PROBES  = 128;
pub def TDEFL_MAX_PROBES_MASK     = 0xFFF;

pub def TDEFL_WRITE_ZLIB_HEADER             = 0x01000;
pub def TDEFL_COMPUTE_ADLER32               = 0x02000;
pub def TDEFL_GREEDY_PARSING_FLAG           = 0x04000;
pub def TDEFL_NONDETERMINISTIC_PARSING_FLAG = 0x08000;
pub def TDEFL_RLE_MATCHES                   = 0x10000;
pub def TDEFL_FILTER_MATCHES                = 0x20000;
pub def TDEFL_FORCE_ALL_STATIC_BLOCKS       = 0x40000;
pub def TDEFL_FORCE_ALL_RAW_BLOCKS          = 0x80000;

pub def TDEFL_MAX_HUFF_TABLES   = 3;
pub def TDEFL_MAX_HUFF_SYMBOLS_0 = 288;
pub def TDEFL_MAX_HUFF_SYMBOLS_1 = 32;
pub def TDEFL_MAX_HUFF_SYMBOLS_2 = 19;
pub def TDEFL_LZ_DICT_SIZE      = 32768;
pub def TDEFL_LZ_DICT_SIZE_MASK = 32767;
pub def TDEFL_MIN_MATCH_LEN     = 3;
pub def TDEFL_MAX_MATCH_LEN     = 258;

/* Using the non-LESS_MEMORY variant sizes */
pub def TDEFL_LZ_CODE_BUF_SIZE      = 65536;
pub def TDEFL_OUT_BUF_SIZE          = 83200; /* (64*1024 * 13) / 10 */
pub def TDEFL_MAX_HUFF_SYMBOLS      = 288;
pub def TDEFL_LZ_HASH_BITS          = 15;
pub def TDEFL_LEVEL1_HASH_SIZE_MASK = 4095;
pub def TDEFL_LZ_HASH_SHIFT         = 5; /* (15 + 2) / 3 */
pub def TDEFL_LZ_HASH_SIZE          = 32768; /* 1 << 15 */

pub enum tdefl_status : int32
{
    TDEFL_STATUS_BAD_PARAM      = -2,
    TDEFL_STATUS_PUT_BUF_FAILED = -1,
    TDEFL_STATUS_OKAY           = 0,
    TDEFL_STATUS_DONE           = 1
}

pub enum tdefl_flush : int32
{
    TDEFL_NO_FLUSH   = 0,
    TDEFL_SYNC_FLUSH = 2,
    TDEFL_FULL_FLUSH = 3,
    TDEFL_FINISH     = 4
}

pub alias tdefl_put_buf_func_ptr = fn(pBuf : const void*, len : int32, pUser : void*) : mz_bool;

pub struct tdefl_compressor
{
    m_pPut_buf_func   : tdefl_put_buf_func_ptr;
    m_pPut_buf_user   : void*;
    m_flags           : uint32;
    m_max_probes      : uint32[2];
    m_greedy_parsing  : int32;
    m_adler32         : uint32;
    m_lookahead_pos   : uint32;
    m_lookahead_size  : uint32;
    m_dict_size       : uint32;
    m_pLZ_code_buf    : uint8*;
    m_pLZ_flags       : uint8*;
    m_pOutput_buf     : uint8*;
    m_pOutput_buf_end : uint8*;
    m_num_flags_left          : uint32;
    m_total_lz_bytes          : uint32;
    m_lz_code_buf_dict_pos    : uint32;
    m_bits_in                 : uint32;
    m_bit_buffer              : uint32;
    m_saved_match_dist        : uint32;
    m_saved_match_len         : uint32;
    m_saved_lit               : uint32;
    m_output_flush_ofs        : uint32;
    m_output_flush_remaining  : uint32;
    m_finished                : uint32;
    m_block_index             : uint32;
    m_wants_to_finish         : uint32;
    m_prev_return_status      : tdefl_status;
    m_pIn_buf                 : const void*;
    m_pOut_buf                : void*;
    m_pIn_buf_size            : usize*;
    m_pOut_buf_size           : usize*;
    m_flush                   : tdefl_flush;
    m_pSrc                    : const uint8*;
    m_src_buf_left            : usize;
    m_out_buf_ofs             : usize;
    m_dict          : uint8[32257];  /* TDEFL_LZ_DICT_SIZE + TDEFL_MAX_MATCH_LEN - 1 */
    m_huff_count    : uint16[3][288];
    m_huff_codes    : uint16[3][288];
    m_huff_code_sizes : uint8[3][288];
    m_lz_code_buf   : uint8[65536];  /* TDEFL_LZ_CODE_BUF_SIZE */
    m_next          : uint16[32768]; /* TDEFL_LZ_DICT_SIZE */
    m_hash          : uint16[32768]; /* TDEFL_LZ_HASH_SIZE */
    m_output_buf    : uint8[83200];  /* TDEFL_OUT_BUF_SIZE */
}

pub fn tdefl_compress_mem_to_heap(pSrc_buf : const void*, src_buf_len : usize, pOut_len : usize*, flags : int32) : void*;
pub fn tdefl_compress_mem_to_mem(pOut_buf : void*, out_buf_len : usize, pSrc_buf : const void*, src_buf_len : usize, flags : int32) : usize;
pub fn tdefl_write_image_to_png_file_in_memory_ex(pImage : const void*, w : int32, h : int32, num_chans : int32, pLen_out : usize*, level : uint32, flip : mz_bool) : void*;
pub fn tdefl_write_image_to_png_file_in_memory(pImage : const void*, w : int32, h : int32, num_chans : int32, pLen_out : usize*) : void*;
pub fn tdefl_compress_mem_to_output(pBuf : const void*, buf_len : usize, pPut_buf_func : tdefl_put_buf_func_ptr, pPut_buf_user : void*, flags : int32) : mz_bool;

pub fn tdefl_init(d : tdefl_compressor*, pPut_buf_func : tdefl_put_buf_func_ptr, pPut_buf_user : void*, flags : int32) : tdefl_status;
pub fn tdefl_compress(d : tdefl_compressor*, pIn_buf : const void*, pIn_buf_size : usize*, pOut_buf : void*, pOut_buf_size : usize*, flush : tdefl_flush) : tdefl_status;
pub fn tdefl_compress_buffer(d : tdefl_compressor*, pIn_buf : const void*, in_buf_size : usize, flush : tdefl_flush) : tdefl_status;
pub fn tdefl_get_prev_return_status(d : tdefl_compressor*) : tdefl_status;
pub fn tdefl_get_adler32(d : tdefl_compressor*) : uint32;
pub fn tdefl_create_comp_flags_from_zip_params(level : int32, window_bits : int32, strategy : int32) : uint32;
pub fn tdefl_compressor_alloc() : tdefl_compressor*;
pub fn tdefl_compressor_free(pComp : tdefl_compressor*) : void;

/* ------------------- tinfl (low-level decompressor) */

pub def TINFL_FLAG_PARSE_ZLIB_HEADER           = 1;
pub def TINFL_FLAG_HAS_MORE_INPUT              = 2;
pub def TINFL_FLAG_USING_NON_WRAPPING_OUTPUT_BUF = 4;
pub def TINFL_FLAG_COMPUTE_ADLER32             = 8;

pub def TINFL_LZ_DICT_SIZE = 32768;

pub def TINFL_MAX_HUFF_TABLES    = 3;
pub def TINFL_MAX_HUFF_SYMBOLS_0 = 288;
pub def TINFL_MAX_HUFF_SYMBOLS_1 = 32;
pub def TINFL_MAX_HUFF_SYMBOLS_2 = 19;
pub def TINFL_FAST_LOOKUP_BITS   = 10;
pub def TINFL_FAST_LOOKUP_SIZE   = 1024; /* 1 << 10 */

pub enum tinfl_status : int32
{
    TINFL_STATUS_FAILED_CANNOT_MAKE_PROGRESS = -4,
    TINFL_STATUS_BAD_PARAM                   = -3,
    TINFL_STATUS_ADLER32_MISMATCH            = -2,
    TINFL_STATUS_FAILED                      = -1,
    TINFL_STATUS_DONE                        = 0,
    TINFL_STATUS_NEEDS_MORE_INPUT            = 1,
    TINFL_STATUS_HAS_MORE_OUTPUT             = 2
}

/* tinfl_bit_buf_t is uint64 on 64-bit (MINIZ_HAS_64BIT_REGISTERS assumed true) */
pub alias tinfl_bit_buf_t = uint64;

pub struct tinfl_decompressor_tag
{
    m_state        : uint32;
    m_num_bits     : uint32;
    m_zhdr0        : uint32;
    m_zhdr1        : uint32;
    m_z_adler32    : uint32;
    m_final        : uint32;
    m_type         : uint32;
    m_check_adler32 : uint32;
    m_dist         : uint32;
    m_counter      : uint32;
    m_num_extra    : uint32;
    m_table_sizes  : uint32[3]; /* TINFL_MAX_HUFF_TABLES */
    m_bit_buf      : uint64;//tinfl_bit_buf_t;
    m_dist_from_out_buf_start : usize;
    m_look_up      : int16[3][1024];  /* [TINFL_MAX_HUFF_TABLES][TINFL_FAST_LOOKUP_SIZE] */
    m_tree_0       : int16[576];      /* TINFL_MAX_HUFF_SYMBOLS_0 * 2 */
    m_tree_1       : int16[64];       /* TINFL_MAX_HUFF_SYMBOLS_1 * 2 */
    m_tree_2       : int16[38];       /* TINFL_MAX_HUFF_SYMBOLS_2 * 2 */
    m_code_size_0  : uint8[288];      /* TINFL_MAX_HUFF_SYMBOLS_0 */
    m_code_size_1  : uint8[32];       /* TINFL_MAX_HUFF_SYMBOLS_1 */
    m_code_size_2  : uint8[19];       /* TINFL_MAX_HUFF_SYMBOLS_2 */
    m_raw_header   : uint8[4];
    m_len_codes    : uint8[457];      /* TINFL_MAX_HUFF_SYMBOLS_0 + TINFL_MAX_HUFF_SYMBOLS_1 + 137 */
}

pub alias tinfl_decompressor = tinfl_decompressor_tag;

pub fn tinfl_decompress_mem_to_heap(pSrc_buf : const void*, src_buf_len : usize, pOut_len : usize*, flags : int32) : void*;
pub fn tinfl_decompress_mem_to_mem(pOut_buf : void*, out_buf_len : usize, pSrc_buf : const void*, src_buf_len : usize, flags : int32) : usize;

pub alias tinfl_put_buf_func_ptr = fn(pBuf : const void*, len : int32, pUser : void*) : int32;
pub fn tinfl_decompress_mem_to_callback(pIn_buf : const void*, pIn_buf_size : usize*, pPut_buf_func : tinfl_put_buf_func_ptr, pPut_buf_user : void*, flags : int32) : int32;

pub fn tinfl_decompressor_alloc() : tinfl_decompressor*;
pub fn tinfl_decompressor_free(pDecomp : tinfl_decompressor*) : void;

pub fn tinfl_decompress(r : tinfl_decompressor*, pIn_buf_next : const uint8*, pIn_buf_size : usize*, pOut_buf_start : uint8*, pOut_buf_next : uint8*, pOut_buf_size : usize*, decomp_flags : uint32) : tinfl_status;

/* ------------------- ZIP archive types */

pub enum mz_zip_mode : int32
{
    MZ_ZIP_MODE_INVALID = 0,
    MZ_ZIP_MODE_READING = 1,
    MZ_ZIP_MODE_WRITING = 2,
    MZ_ZIP_MODE_WRITING_HAS_BEEN_FINALIZED = 3
}

pub enum mz_zip_type : int32
{
    MZ_ZIP_TYPE_INVALID = 0,
    MZ_ZIP_TYPE_USER,
    MZ_ZIP_TYPE_MEMORY,
    MZ_ZIP_TYPE_HEAP,
    MZ_ZIP_TYPE_FILE,
    MZ_ZIP_TYPE_CFILE,
    MZ_ZIP_TOTAL_TYPES
}

pub enum mz_zip_error : int32
{
    MZ_ZIP_NO_ERROR = 0,
    MZ_ZIP_UNDEFINED_ERROR,
    MZ_ZIP_TOO_MANY_FILES,
    MZ_ZIP_FILE_TOO_LARGE,
    MZ_ZIP_UNSUPPORTED_METHOD,
    MZ_ZIP_UNSUPPORTED_ENCRYPTION,
    MZ_ZIP_UNSUPPORTED_FEATURE,
    MZ_ZIP_FAILED_FINDING_CENTRAL_DIR,
    MZ_ZIP_NOT_AN_ARCHIVE,
    MZ_ZIP_INVALID_HEADER_OR_CORRUPTED,
    MZ_ZIP_UNSUPPORTED_MULTIDISK,
    MZ_ZIP_DECOMPRESSION_FAILED,
    MZ_ZIP_COMPRESSION_FAILED,
    MZ_ZIP_UNEXPECTED_DECOMPRESSED_SIZE,
    MZ_ZIP_CRC_CHECK_FAILED,
    MZ_ZIP_UNSUPPORTED_CDIR_SIZE,
    MZ_ZIP_ALLOC_FAILED,
    MZ_ZIP_FILE_OPEN_FAILED,
    MZ_ZIP_FILE_CREATE_FAILED,
    MZ_ZIP_FILE_WRITE_FAILED,
    MZ_ZIP_FILE_READ_FAILED,
    MZ_ZIP_FILE_CLOSE_FAILED,
    MZ_ZIP_FILE_SEEK_FAILED,
    MZ_ZIP_FILE_STAT_FAILED,
    MZ_ZIP_INVALID_PARAMETER,
    MZ_ZIP_INVALID_FILENAME,
    MZ_ZIP_BUF_TOO_SMALL,
    MZ_ZIP_INTERNAL_ERROR,
    MZ_ZIP_FILE_NOT_FOUND,
    MZ_ZIP_ARCHIVE_TOO_LARGE,
    MZ_ZIP_VALIDATION_FAILED,
    MZ_ZIP_WRITE_CALLBACK_FAILED,
    MZ_ZIP_TOTAL_ERRORS
}

/* [[flags]] would be ideal here, but plain enum + def constants works too */
pub def MZ_ZIP_FLAG_CASE_SENSITIVE              = 0x0100u32;
pub def MZ_ZIP_FLAG_IGNORE_PATH                 = 0x0200u32;
pub def MZ_ZIP_FLAG_COMPRESSED_DATA             = 0x0400u32;
pub def MZ_ZIP_FLAG_DO_NOT_SORT_CENTRAL_DIRECTORY = 0x0800u32;
pub def MZ_ZIP_FLAG_VALIDATE_LOCATE_FILE_FLAG   = 0x1000u32;
pub def MZ_ZIP_FLAG_VALIDATE_HEADERS_ONLY       = 0x2000u32;
pub def MZ_ZIP_FLAG_WRITE_ZIP64                 = 0x4000u32;
pub def MZ_ZIP_FLAG_WRITE_ALLOW_READING         = 0x8000u32;
pub def MZ_ZIP_FLAG_ASCII_FILENAME              = 0x10000u32;
pub def MZ_ZIP_FLAG_WRITE_HEADER_SET_SIZE       = 0x20000u32;

pub def MZ_ZIP_MAX_IO_BUF_SIZE               = 65536;
pub def MZ_ZIP_MAX_ARCHIVE_FILENAME_SIZE     = 512;
pub def MZ_ZIP_MAX_ARCHIVE_FILE_COMMENT_SIZE = 512;

pub struct mz_zip_array
{
    m_p            : void*;
    m_size         : usize;
    m_capacity     : usize;
    m_element_size : uint32;
}

pub struct mz_zip_internal_state_tag;
pub alias mz_zip_internal_state = mz_zip_internal_state_tag;

pub struct mz_zip_archive_file_stat
{
    m_file_index      : uint32;
    m_central_dir_ofs : uint64;
    m_version_made_by : uint16;
    m_version_needed  : uint16;
    m_bit_flag        : uint16;
    m_method          : uint16;
    m_crc32           : uint32;
    m_comp_size       : uint64;
    m_uncomp_size     : uint64;
    m_internal_attr   : uint16;
    m_external_attr   : uint32;
    m_local_header_ofs : uint64;
    m_comment_size    : uint32;
    m_is_directory    : mz_bool;
    m_is_encrypted    : mz_bool;
    m_is_supported    : mz_bool;
    m_filename        : uint8[512]; /* MZ_ZIP_MAX_ARCHIVE_FILENAME_SIZE */
    m_comment         : uint8[512]; /* MZ_ZIP_MAX_ARCHIVE_FILE_COMMENT_SIZE */
    m_time            : MZ_TIME;
}

pub struct mz_zip_archive
{
    m_archive_size             : uint64;
    m_central_directory_file_ofs : uint64;
    m_total_files              : uint32;
    m_zip_mode                 : mz_zip_mode;
    m_zip_type                 : mz_zip_type;
    m_last_error               : mz_zip_error;
    m_file_offset_alignment    : uint64;
    m_pAlloc                   : mz_alloc_func;
    m_pFree                    : mz_free_func;
    m_pRealloc                 : mz_realloc_func;
    m_pAlloc_opaque            : void*;
    m_pRead                    : mz_file_read_func;
    m_pWrite                   : mz_file_write_func;
    m_pNeeds_keepalive         : mz_file_needs_keepalive;
    m_pIO_opaque               : void*;
    m_pState                   : mz_zip_internal_state*;
}

pub struct mz_zip_reader_extract_iter_state
{
    pZip            : mz_zip_archive*;
    flags           : uint32;
    status          : int32;
    read_buf_size   : uint64;
    read_buf_ofs    : uint64;
    read_buf_avail  : uint64;
    comp_remaining  : uint64;
    out_buf_ofs     : uint64;
    cur_file_ofs    : uint64;
    file_stat       : mz_zip_archive_file_stat;
    pRead_buf       : void*;
    pWrite_buf      : void*;
    out_blk_remain  : usize;
    inflator        : tinfl_decompressor;
    file_crc32      : uint32;
}

