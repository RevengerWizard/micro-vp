pub fn mz_zip_reader_locate_file_v2(pZip : mz_zip_archive*, pName : const uint8*, pComment : const uint8*, flags : uint32, file_index : uint32*) : mz_bool;

pub fn mz_zip_reader_extract_to_mem_no_alloc(pZip : mz_zip_archive*, file_index : uint32, pBuf : void*, buf_size : usize, flags : uint32, pUser_read_buf : void*, user_read_buf_size : usize) : mz_bool;
