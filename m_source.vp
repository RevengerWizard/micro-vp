fn source_fromData(T : tea_State*) : void
{
    let data : Data* = ptrcast(Data*, tea_check_udata(T, 0, "micro.Data"));
    let self : Source* = newSource(T);
    self.data = data;
    tea_push_value(T, 0);
    self.dataRef = teax_ref(T, TEA_REGISTRY_INDEX);

    var initiated : bool = false;
    /* Is .wav? */
    var n : const uint8* = "WAVE";  // bug...
    if data.len > 12 and mem::cmp(ptrcast(const uint8*, data.data) + 8, n, 4) == 0
    {
        self.onEvent = onEventWav;
        initiated = true;
    }
    /* Is .ogg? */
    n = "OggS";
    if !initiated and data.len > 4 and mem::cmp(data.data, n, 4) == 0
    {
        self.onEvent = onEventOgg;
        initiated = true;
    }
    if !initiated
    {
        tea_error(T, "could not init Source; bad Data format?");
    }
    var e : SourceEvent = makeEvent(SOURCE_EVENT_INIT);
    e.teaState = T;
    emitEvent(self, &e);
    self.rate = intcast(int32, getBaseRate(self) * floatcast(float64, FX_UNIT));
    self.dest = master;
    var c : Command = makeCommand(COMMAND_ADD, self);
    pushCommand(&c);
}

fn source_fromBlank(T : tea_State*) : void
{
    let self : Source* = newSource(T);
    self.dest = master;
    var c : Command = makeCommand(COMMAND_ADD, self);
    pushCommand(&c);
}

fn source_getLength(T : tea_State*) : void
{
    let self : Source* = checkSource(T, 0);
    tea_push_number(T, getBaseRate(self) * floatcast(float64, self.length) / floatcast(float64, self.samplerate));
}

fn source_getState(T : tea_State*) : void
{
    let self : Source* = checkSource(T, 0);
    switch self.state
    case SOURCE_STATE_PLAYING return tea_push_lstring(T, "playing", 7);
    case SOURCE_STATE_PAUSED return tea_push_lstring(T, "paused",  6);
    case SOURCE_STATE_STOPPED return tea_push_lstring(T, "stopped", 7);
    default return tea_push_lstring(T, "?", 1);
}

fn source_setDestination(T : tea_State*) : void
{
    let self : Source* = checkSource(T, 0);
    var dest : Source* = master;
    //if !tea_is_nonenil(T, 1)
    if !(tea_get_type(T, (1)) <= TEA_TYPE_NIL)
    {
        dest = checkSource(T, 1);
    }
    if self == master
    {
        tea_arg_error(T, 1, "master cannot be rerouted");
    }
    var s : Source* = dest;
    while s != nil
    {
        if s == self
        {
            tea_error(T, "routing results in a feedback loop");
        }
        s = s.dest;
    }
    var c : Command = makeCommand(COMMAND_SET_DESTINATION, self);
    //if !tea_is_nonenil(T, 1)
    if !(tea_get_type(T, (1)) <= TEA_TYPE_NIL)
    {
        tea_push_value(T, 1);
    }
    else
    {
        tea_push_integer(T, masterRef);
        tea_get_field(T, TEA_REGISTRY_INDEX);
    }
    c.i = teax_ref(T, TEA_REGISTRY_INDEX);
    c.p = dest;
    pushCommand(&c);
}

fn source_setGain(T : tea_State*) : void
{
    let self : Source* = checkSource(T, 0);
    let gain : float64 = tea_opt_number(T, 1, 1);
    var c : Command = makeCommand(COMMAND_SET_GAIN, self);
    c.f = gain;
    pushCommand(&c);
}

fn source_setPan(T : tea_State*) : void
{
    let self : Source* = checkSource(T, 0);
    let pan : float64 = tea_opt_number(T, 1, 0);
    var c : Command = makeCommand(COMMAND_SET_PAN, self);
    c.f = pan;
    pushCommand(&c);
}

fn source_setRate(T : tea_State*) : void
{
    let self : Source* = checkSource(T, 0);
    let rate : float64 = tea_opt_number(T, 1, 1);
    if rate < float64(0.0)
    {
        tea_arg_error(T, 2, "expected value of zero or greater");
    }
    if rate > float64(16.0)
    {
        tea_arg_error(T, 2, "value is too large");
    }
    var c : Command = makeCommand(COMMAND_SET_RATE, self);
    c.f = rate;
    pushCommand(&c);
}

fn source_setLoop(T : tea_State*) : void
{
    let self : Source* = checkSource(T, 0);
    let loop : bool = tea_opt_bool(T, 1, false);
    var c : Command = makeCommand(COMMAND_SET_LOOP, self);
    c.i = loop ? 1 : 0;
    pushCommand(&c);
}

fn source_play(T : tea_State*) : void
{
    let self : Source* = checkSource(T, 0);
    let reset : bool = tea_opt_bool(T, 1, false);
    var c : Command = makeCommand(COMMAND_PLAY, self);
    c.i = reset ? 1 : 0;
    pushCommand(&c);
}

fn source_pause(T : tea_State*) : void
{
    let self : Source* = checkSource(T, 0);
    var c : Command = makeCommand(COMMAND_PAUSE, self);
    pushCommand(&c);
}

fn source_stop(T : tea_State*) : void
{
    let self : Source* = checkSource(T, 0);
    var c : Command = makeCommand(COMMAND_STOP, self);
    pushCommand(&c);
}

let srreg : const tea_Methods[] =
{
    {"fromData", "static", source_fromData, 1, 0},
    {"fromBlank", "static", source_fromBlank, 1, 0},
    {"getLength", "method", source_getLength, 1, 0},
    {"getState", "method", source_getState, 1, 0},
    {"setDestination", "method", source_setDestination, 1, 1},
    {"setGain", "method", source_setGain, 1, 1},
    {"setPan", "method", source_setPan, 1, 1},
    {"setRate", "method", source_setRate, 1, 1},
    {"setLoop", "method", source_setLoop, 1, 1},
    {"play", "method", source_play, 1, 1},
    {"pause", "method", source_pause, 1, 0},
    {"stop", "method", source_stop, 1, 0},
    {}
};

pub fn micro_open_Source(T : tea_State*) : void
{
    tea_create_class(T, "Source", srreg);
    tea_push_value(T, -1);
    tea_set_key(T, TEA_REGISTRY_INDEX, "micro.Source");
    teaState = T;
    master = newSource(T);
    masterRef = teax_ref(T, TEA_REGISTRY_INDEX);
    let c : Command = makeCommand(COMMAND_ADD, master);
    pushCommand(&c);
}