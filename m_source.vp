pub fn source_process(self : Source*, len : int32) : void
{
    /* Replace flag still set? Zeroset the buffer */
    if (self.flags & SOURCE_FREPLACE) != 0
    {
        mem::set(self.buf, 0, intcast(usize, len) * sizeof(int32));
    }
    /* Process audio stream */
    if self.state == SOURCE_STATE_PLAYING and self.onEvent != nil
    {
        var i : int32 = 0;
        while i < len
        {
            let idx : int32 = intcast(int32, self.position >> FX_BITS);
            /* Fill raw buffer if needed */
            if idx + 1 >= self.bufEnd
            {
                var e : SourceEvent = makeEvent(SOURCE_EVENT_PROCESS);
                e.offset = self.bufEnd & SOURCE_BUFFER_MASK;
                e.len = SOURCE_BUFFER_MAX / 2;
                emitEvent(self, &e);
                self.bufEnd = self.bufEnd + e.len;
            }
            /* Reached the end? */
            if idx >= self.end
            {
                if (~self.flags & SOURCE_FLOOP) != 0
                {
                    self.state = SOURCE_STATE_STOPPED;
                    break;
                }
                self.end = idx + self.length;
            }
            /* Write interpolated frame */
            let p : int32 = intcast(int32, self.position & intcast(int64, FX_MASK));
            let la : int32 = self.rawBufLeft[idx & SOURCE_BUFFER_MASK];
            let lb : int32 = self.rawBufLeft[(idx + 1) & SOURCE_BUFFER_MASK];
            self.buf[i] = self.buf[i] + fxlerp(la, lb, p);
            let ra : int32 = self.rawBufRight[idx & SOURCE_BUFFER_MASK];
            let rb : int32 = self.rawBufRight[(idx + 1) & SOURCE_BUFFER_MASK];
            self.buf[i + 1] = self.buf[i + 1] + fxlerp(ra, rb, p);
            self.position = self.position + intcast(int64, self.rate);
            i = i + 2;
        }
    }
    /* Apply gains */
    var i : int32 = 0;
    while i < len
    {
        self.buf[i] = (self.buf[i] * self.lgain) >> FX_BITS;
        self.buf[i + 1] = (self.buf[i + 1] * self.rgain) >> FX_BITS;
        i = i + 2;
    }
    /* Write to destination */
    if self.dest != nil
    {
        if (self.dest.flags & SOURCE_FREPLACE) != 0
        {
            mem::copy(self.dest.buf, self.buf, intcast(usize, len) * sizeof(int32));
            self.dest.flags &= ~SOURCE_FREPLACE;
        }
        else
        {
            var j : int32 = 0;
            while j < len
            {
                self.dest.buf[j] = self.dest.buf[j] + self.buf[j];
                j++;
            }
        }
    }
    self.flags |= SOURCE_FREPLACE;
}

