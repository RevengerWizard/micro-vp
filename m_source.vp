from tea import *
import std::mem as mem
from teax import *
from m_data import Data

def SOURCE_BUFFER_MAX : int32 = 4096;
def SOURCE_BUFFER_MASK : int32 = SOURCE_BUFFER_MAX - 1;

def FX_BITS : int32 = 12;
def FX_UNIT : int32 = 1 << FX_BITS;
def FX_MASK : int32 = FX_UNIT - 1;

def SOURCE_FLOOP : int32 = 1 << 0;
def SOURCE_FREPLACE : int32 = 1 << 1;

def SOURCE_STATE_STOPPED : int32 = 0;
def SOURCE_STATE_PLAYING : int32 = 1;
def SOURCE_STATE_PAUSED : int32 = 2;

def SOURCE_EVENT_NULL : int32 = 0;
def SOURCE_EVENT_INIT : int32 = 1;
def SOURCE_EVENT_DEINIT : int32 = 2;
def SOURCE_EVENT_REWIND : int32 = 3;
def SOURCE_EVENT_PROCESS : int32 = 4;

def COMMAND_NULL : int32 = 0;
def COMMAND_ADD : int32 = 1;
def COMMAND_DESTROY : int32 = 2;
def COMMAND_PLAY : int32 = 3;
def COMMAND_PAUSE : int32 = 4;
def COMMAND_STOP : int32 = 5;
def COMMAND_SET_DESTINATION : int32 = 6;
def COMMAND_SET_GAIN : int32 = 7;
def COMMAND_SET_PAN : int32 = 8;
def COMMAND_SET_RATE : int32 = 9;
def COMMAND_SET_LOOP : int32 = 10;

struct SourceEvent
{
    tt : int32;
    teaState : tea_State*;
    offset : int32;
    len : int32;
}

alias SourceEventHandler = fn(Source*, SourceEvent*) : void;

struct Source
{
    rawBufLeft  : int32[SOURCE_BUFFER_MAX];
    rawBufRight : int32[SOURCE_BUFFER_MAX];
    buf : int32[SOURCE_BUFFER_MAX];
    dataRef, destRef : int32;
    data : Data*;
    dest : Source*;
    onEvent : SourceEventHandler;
    samplerate : int32;
    state : int32;
    flags : int32;
    length : int32;
    rate : int32;
    position : int64;
    end : int32;
    bufEnd : int32;
    lgain, rgain : int32;
    gain, pan : float64;
    union
    {
        /* .wav */
        struct
        {
            //wav : wav_t;
            wavIdx : int32;
        }
        /* .ogg */
        struct
        {
            //oggStream : stb_vorbis*;
            oggStream : void*;
        }
    }
}

struct Command
{
    tt : int32;
    source : Source*;
    i : int32;
    f : float64;
    p : void*;
}

var samplerate : int32 = 44100;
var master : Source*;
var masterRef : int32 = TEA_NOREF;
//var sources : vec_t(Source*);
var sources : Source**;
var teaState : tea_State*;
//var commands : vec_t(Command);
var commands : Command*;

inline fn fxlerp(a : int32, b : int32, p : int32) : int32
{
    return a + (((b - a) * p) >> FX_BITS);
}

fn makeCommand(tt : int32, source : Source*) : Command
{
    var c : Command;
    mem::set(&c, 0, sizeof(Command));
    c.tt = tt;
    c.source = source;
    return c;
}

fn pushCommand(c : Command*) : void
{
    //vec_push(&commands, *c);
}

fn makeEvent(tt : int32) : SourceEvent
{
    var e : SourceEvent;
    mem::set(&e, 0, sizeof(SourceEvent));
    e.tt = tt;
    return e;
}

fn emitEvent(s : Source*, e : SourceEvent*) : void
{
    if s.onEvent != nil
    {
        s.onEvent(s, e);
    }
}

fn recalcGains(self : Source*) : void
{
    var pan  : float64 = self.pan < float64(-1.0) ? -1.0 : (self.pan > float64(1.0) ? 1.0 : self.pan);
    var gain : float64 = self.gain < float64(0.0) ? 0.0 : self.gain;
    var left  : float64 = ((pan < float64(0.0)) ? 1.0 : (1.0 - pan)) * gain;
    var right : float64 = ((pan > float64(0.0)) ? 1.0 : (1.0 + pan)) * gain;
    left  = left  * left;
    right = right * right;
    self.lgain = intcast(int32, left  * floatcast(float64, FX_UNIT));
    self.rgain = intcast(int32, right * floatcast(float64, FX_UNIT));
}

fn checkSource(T : tea_State*, idx : int32) : Source*
{
    let p : Source** = tea_check_udata(T, idx, "micro.Source");
    return *p;
}

fn source_free(ud : void*) : void
{
    let self : Source* = ptrcast(Source*, ud);
    var c : Command = makeCommand(COMMAND_DESTROY, self);
    pushCommand(&c);
}

fn newSource(T : tea_State*) : Source*
{
    let self : Source* = mem::alloc(sizeof(Source));
    mem::set(self, 0, sizeof(Source));
    self.dataRef = TEA_NOREF;
    self.destRef = TEA_NOREF;
    self.gain = 1.0;
    self.pan  = 0.0;
    recalcGains(self);
    let p : Source** = tea_new_udata(T, sizeof(Source*), "micro.Source");
    tea_set_finalizer(T, source_free);
    *p = self;
    return self;
}

fn destroySource(self : Source*) : void
{
    var e : SourceEvent = makeEvent(SOURCE_EVENT_DEINIT);
    emitEvent(self, &e);
    mem::free(self);
}

fn getBaseRate(self : Source*) : float64
{
    return floatcast(float64, self.samplerate) / floatcast(float64, samplerate);
}

fn rewindStream(self : Source*, position : int64) : void
{
    var e : SourceEvent = makeEvent(SOURCE_EVENT_REWIND);
    emitEvent(self, &e);
    e = makeEvent(SOURCE_EVENT_PROCESS);
    e.offset = 0;
    e.len = SOURCE_BUFFER_MAX / 2;
    emitEvent(self, &e);
    self.end    = self.length;
    self.bufEnd = e.len;
    self.position = position;
}

