fn timer_getTime(T : tea_State*) : void
{
    let time : float64 = glfwGetTime();
    tea_push_number(T, time);
}

let treg : const tea_Reg[] = {
    //{"getNow", timer_getNow, 0, 0},
    {"getTime", timer_getTime, 0, 0},
    {}
};

pub fn micro_open_timer(T : tea_State*) : void
{
    tea_create_submodule(T, "timer", treg);
}