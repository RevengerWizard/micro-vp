pub struct ma_allocation_callbacks
{
    pUserData : void*;
    onMalloc : fn(sz : size_t, pUserData : void*) : void*;
    onRealloc : fn(p : void*, sz : size_t, pUserData : void*) : void*;
    onFree : fn(p : void*, pUserData : void*) : void;
}

pub struct ma_log_callback
{
    onLog : fn(pUserData : void*, level : ma_uint32, pMessage : const int8*) : void;
    pUserData : void*;
}

pub struct ma_log
{
    callbacks : ma_log_callback[4];
    callbackCount : ma_uint32;
    allocationCallbacks : ma_allocation_callbacks;
    lock : ma_mutex;
}

pub union ma_device_id
{
    wasapi : ma_wchar_win32[64];
    dsound : ma_uint8[16];
    winmm : ma_uint32;
    alsa : int8[256];
    pulse : int8[256];
    jack : int32;
    coreaudio : int8[256];
    sndio : int8[256];
    audio4 : int8[256];
    oss : int8[64];
    aaudio : ma_int32;
    opensl : ma_uint32;
    webaudio : int8[32];
    custom : union {
        i : int32;
        s : int8[256];
        p : void*;
    };
    nullbackend : int32;
}

pub struct ma_device_info_data_formats
{
    format : ma_format;
    channels : ma_uint32;
    sampleRate : ma_uint32;
    flags : ma_uint32;
}

pub struct ma_device_info
{
    id : ma_device_id;
    name : int8[256];
    isDefault : ma_bool32;
    nativeDataFormatCount : ma_uint32;
    /*nativeDataFormats : struct {
        format : ma_format;
        channels : ma_uint32;
        sampleRate : ma_uint32;
        flags : ma_uint32;
    }[64];*/
    nativeDataFormats : ma_device_info_data_formats[64];
}

pub struct ma_device_descriptor
{
    pDeviceID : const ma_device_id*;
    shareMode : ma_share_mode;
    format : ma_format;
    channels : ma_uint32;
    sampleRate : ma_uint32;
    channelMap : ma_channel[254];
    periodSizeInFrames : ma_uint32;
    periodSizeInMilliseconds : ma_uint32;
    periodCount : ma_uint32;
}

pub struct ma_backend_callbacks
{
    onContextInit : fn(pContext : ma_context*, pConfig : const ma_context_config*, pCallbacks : ma_backend_callbacks*) : ma_result;
    onContextUninit : fn(pContext : ma_context*) : ma_result;
    onContextEnumerateDevices : fn(pContext : ma_context*, callback : ma_enum_devices_callback_proc, pUserData : void*) : ma_result;
    onContextGetDeviceInfo : fn(pContext : ma_context*, deviceType : ma_device_type, pDeviceID : const ma_device_id*, pDeviceInfo : ma_device_info*) : ma_result;
    onDeviceInit : fn(pDevice : ma_device*, pConfig : const ma_device_config*, pDescriptorPlayback : ma_device_descriptor*, pDescriptorCapture : ma_device_descriptor*) : ma_result;
    onDeviceUninit : fn(pDevice : ma_device*) : ma_result;
    onDeviceStart : fn(pDevice : ma_device*) : ma_result;
    onDeviceStop : fn(pDevice : ma_device*) : ma_result;
    onDeviceRead : fn(pDevice : ma_device*, pFrames : void*, frameCount : ma_uint32, pFramesRead : ma_uint32*) : ma_result;
    onDeviceWrite : fn(pDevice : ma_device*, pFrames : const void*, frameCount : ma_uint32, pFramesWritten : ma_uint32*) : ma_result;
    onDeviceDataLoop : fn(pDevice : ma_device*) : ma_result;
    onDeviceDataLoopWakeup : fn(pDevice : ma_device*) : ma_result;
    onDeviceGetInfo : fn(pDevice : ma_device*, _type : ma_device_type, pDeviceInfo : ma_device_info*) : ma_result;
}

pub struct ma_context_config
{
    pLog : ma_log*;
    threadPriority : ma_thread_priority;
    threadStackSize : size_t;
    pUserData : void*;
    allocationCallbacks : ma_allocation_callbacks;
    alsa : struct {
        useVerboseDeviceEnumeration : ma_bool32;
    };
    pulse : struct {
        pApplicationName : const int8*;
        pServerName : const int8*;
        tryAutoSpawn : ma_bool32;
    };
    coreaudio : struct {
        sessionCategory : ma_ios_session_category;
        sessionCategoryOptions : ma_uint32;
        noAudioSessionActivate : ma_bool32;
        noAudioSessionDeactivate : ma_bool32;
    };
    jack : struct {
        pClientName : const int8*;
        tryStartServer : ma_bool32;
    };
    custom : ma_backend_callbacks;
}

pub enum ma_ios_session_category : int32
{
    ma_ios_session_category_default = 0,
    ma_ios_session_category_none = 1,
    ma_ios_session_category_ambient = 2,
    ma_ios_session_category_solo_ambient = 3,
    ma_ios_session_category_playback = 4,
    ma_ios_session_category_record = 5,
    ma_ios_session_category_play_and_record = 6,
    ma_ios_session_category_multi_route = 7
}

pub struct ma_resampler_config
{
    format : ma_format;
    channels : ma_uint32;
    sampleRateIn : ma_uint32;
    sampleRateOut : ma_uint32;
    algorithm : ma_resample_algorithm;
    pBackendVTable : ma_resampling_backend_vtable*;
    pBackendUserData : void*;
    linear : struct {
        lpfOrder : ma_uint32;
    };
}

pub struct ma_resampling_backend_vtable
{
    onGetHeapSize : fn(pUserData : void*, pConfig : const ma_resampler_config*, pHeapSizeInBytes : size_t*) : ma_result;
    onInit : fn(pUserData : void*, pConfig : const ma_resampler_config*, pHeap : void*, ppBackend : void**) : ma_result;
    onUninit : fn(pUserData : void*, pBackend : void*, pAllocationCallbacks : const ma_allocation_callbacks*) : void;
    onProcess : fn(pUserData : void*, pBackend : void*, pFramesIn : const void*, pFrameCountIn : ma_uint64*, pFramesOut : void*, pFrameCountOut : ma_uint64*) : ma_result;
    onSetRate : fn(pUserData : void*, pBackend : void*, sampleRateIn : ma_uint32, sampleRateOut : ma_uint32) : ma_result;
    onGetInputLatency : fn(pUserData : void*, pBackend : const void*) : ma_uint64;
    onGetOutputLatency : fn(pUserData : void*, pBackend : const void*) : ma_uint64;
    onGetRequiredInputFrameCount : fn(pUserData : void*, pBackend : const void*, outputFrameCount : ma_uint64, pInputFrameCount : ma_uint64*) : ma_result;
    onGetExpectedOutputFrameCount : fn(pUserData : void*, pBackend : const void*, inputFrameCount : ma_uint64, pOutputFrameCount : ma_uint64*) : ma_result;
    onReset : fn(pUserData : void*, pBackend : void*) : ma_result;
}

pub struct ma_device_playback_config
{
    pDeviceID : const ma_device_id*;
