pub fn ma_context_get_devices(pContext : ma_context*, ppPlaybackDeviceInfos : ma_device_info**, pPlaybackDeviceCount : ma_uint32*, ppCaptureDeviceInfos : ma_device_info**, pCaptureDeviceCount : ma_uint32*) : ma_result;
pub fn ma_context_get_device_info(pContext : ma_context*, deviceType : ma_device_type, pDeviceID : const ma_device_id*, pDeviceInfo : ma_device_info*) : ma_result;